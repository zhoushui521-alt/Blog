---
import { projects } from '@/data/profile'

import PageLayout from '@/layouts/CommonPage.astro'
import SupportSection from '@/components/projects/SupportSection.astro'

export const prerender = true
const headings = [
  ...projects.map((p) => ({ depth: 2, slug: p.id, text: p.enName })),
  { depth: 2, slug: 'sponsorship', text: 'Buy me a coffee' }
]
---

<PageLayout title='Open Source' {headings}>
  <p>
    Projects with public source code. Follow the repository links for the code and ongoing changes.
  </p>
  {
    projects.map((p) => (
      <section>
        <h2 id={p.id}>{p.enName}</h2>
        <p>{p.enDescription}</p>
        <a href={p.links.repository} target='_blank' rel='noopener noreferrer'>
          View source on GitHub →
        </a>
      </section>
    ))
  }
  <SupportSection lang='en' />
</PageLayout>
