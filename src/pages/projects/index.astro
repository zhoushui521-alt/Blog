---
import { projects } from '@/data/profile'

import PageLayout from '@/layouts/CommonPage.astro'
import SupportSection from '@/components/projects/SupportSection.astro'

export const prerender = true
const headings = [
  ...projects.map((p) => ({ depth: 2, slug: p.id, text: p.name })),
  { depth: 2, slug: 'sponsorship', text: '请我喝杯咖啡' }
]
---

<PageLayout title='Open Source' {headings}>
  <p>这里放已经公开源码的项目。具体实现和后续改动，可以直接到仓库里看。</p>
  {
    projects.map((p) => (
      <section>
        <h2 id={p.id}>{p.name}</h2>
        <p>{p.description}</p>
        <a href={p.links.repository} target='_blank' rel='noopener noreferrer'>
          GitHub（源码仓库） →
        </a>
      </section>
    ))
  }
  <SupportSection lang='zh' />
</PageLayout>
